{
    "name": "vizra/evals",
    "description": "Evaluation framework for AI agents built on the official Laravel AI SDK.",
    "keywords": ["laravel", "ai", "evals", "evaluation", "llm", "testing"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/ai": "^0.10",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "league/csv": "^9.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.6|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "laravel/pint": "^1.26",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Vizra\\Evals\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vizra\\Evals\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vizra\\Evals\\EvalsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
