{
    "name": "vizra/evals",
    "description": "Evaluation framework for AI agents built on the official Laravel AI SDK.",
    "keywords": [
        "laravel",
        "ai",
        "evals",
        "evaluation",
        "llm",
        "testing",
        "pest",
        "ai-agents",
        "llm-evaluation",
        "laravel-ai-sdk",
        "agent-evaluation",
        "llm-testing"
    ],
    "license": "MIT",
    "homepage": "https://vizra.ai",
    "authors": [
        {
            "name": "Aaron Lumsden",
            "email": "aaron@vizra.ai",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/vizra-ai/vizra-evals/issues",
        "source": "https://github.com/vizra-ai/vizra-evals",
        "docs": "https://docs.vizra.ai/evals"
    },
    "require": {
        "php": "^8.4",
        "laravel/ai": "^0.10",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "league/csv": "^9.0"
    },
    "require-dev": {
        "laravel/pint": "^1.26",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.6|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Vizra\\Evals\\": "src/"
        },
        "files": [
            "src/Pest/Autoload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Vizra\\Evals\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vizra\\Evals\\EvalsServiceProvider"
            ]
        },
        "pest": {
            "plugins": [
                "Vizra\\Evals\\Pest\\Plugin"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint"
    },
    "prefer-stable": true,
    "suggest": {
        "pestphp/pest": "Write evals as Pest tests via the toPassEval() expectation (^4.0 on Laravel 12, ^5.0 on Laravel 13)."
    }
}
